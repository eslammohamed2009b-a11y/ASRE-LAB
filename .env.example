# Frontend (Vercel)
NEXT_PUBLIC_FASTAPI_API_URL=https://your-backend.onrender.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend (Render)
ENV=production
DEBUG=false
PORT=8000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

ALLOWED_ORIGINS=["https://your-frontend.vercel.app"]

JWT_SECRET_KEY=replace_with_long_random_secret
JWT_ALGORITHM=HS256
CELERY_BROKER_URL=redis://your-production-redis-host:6379/0
CELERY_RESULT_BACKEND=redis://your-production-redis-host:6379/1
CELERY_BROKER_VISIBILITY_TIMEOUT=3600
SUPABASE_STORAGE_BUCKET=design-files
