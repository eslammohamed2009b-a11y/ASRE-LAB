# DNS names must already resolve to this VPS before Caddy can obtain TLS certificates.
ASRE_APP_DOMAIN=app.example.com
ASRE_API_DOMAIN=api.example.com

# Browser-visible configuration. These values are baked into the frontend image at build time.
NEXT_PUBLIC_FASTAPI_API_URL=https://api.example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key

# Backend and worker only. Never use the anon key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace_with_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=design-files
ALLOWED_ORIGINS=["https://app.example.com"]
CELERY_BROKER_VISIBILITY_TIMEOUT=3600

# Required by the current startup guard for legacy HS256 token verification.
# Generate a high-entropy value and keep it only in deploy/vps.env.
JWT_SECRET_KEY=replace_with_high_entropy_secret
JWT_ALGORITHM=HS256
